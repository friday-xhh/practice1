# 复制为 .env 后按需修改。所有值都有代码内默认值，不配也能跑。

APP_ENV=development
APP_NAME=content-platform
DEBUG=true
LOG_LEVEL=DEBUG
LOG_JSON=false

# 服务监听地址（每个服务独立进程，键名统一为 HOST/PORT）
HOST=0.0.0.0
PORT=8000

# Redpanda(Kafka 兼容)。容器内互联用 redpanda:29092，宿主机访问用 localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_POST_INGESTED=post.ingested
KAFKA_ACKS=1
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_LINGER_MS=20
KAFKA_BATCH_NUM_MESSAGES=1000

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_CAPACITY=50
RATE_LIMIT_REFILL_PER_SEC=20
RATE_LIMIT_COST=1
IDEMPOTENCY_TTL_SECONDS=86400

# 后续服务使用，本轮仅占位
ELASTICSEARCH_URL=http://localhost:9200
MONGO_URI=mongodb://localhost:27017
